<?php
// Sorteia um número entre 1 e 100
$numeroSecreto = rand(1, 100);
$tentativas = 0;
$acertou = false;

echo "=== ADIVINHAR NÚMERO ===\n";
echo "Tente adivinhar o número secreto entre 1 e 100.\n\n";

while (!$acertou) {
    // Lê a entrada do usuário no terminal
    $palpite = (int)readline("Digite seu palpite: ");
    $tentativas++;

    if ($palpite === $numeroSecreto) {
        echo "Parabéns! Você acertou o número $numeroSecreto em $tentativas tentativas!\n";
        $acertou = true;
    } elseif ($palpite < $numeroSecreto) {
        echo "O número secreto é MAIOR que $palpite. Tente novamente.\n\n";
    } else {
        echo "O número secreto é MENOR que $palpite. Tente novamente.\n\n";
    }
}
?> 
